/* Restore the original strip, power gate, animation controller and XIAO LEDs. */
#include "../GeaconEquinox/GeaconEquinox_led.dtsi"
/ {
    animations {
        nemu_switching_animation: nemu_switching {
            compatible = "zmk,animation-solid";
            pixels = <0 1 2 3>;
            colors = <HSL(45,100,25) HSL(0,0,0)>;
        };
        nemu_ble_animation: nemu_ble {
            compatible = "zmk,animation-solid";
            pixels = <0 1 2 3>;
            colors = <HSL(240,100,25)>;
        };
        nemu_esb_animation: nemu_esb {
            compatible = "zmk,animation-solid";
            pixels = <0 1 2 3>;
            colors = <HSL(120,100,25)>;
        };
        nemu_error_animation: nemu_error {
            compatible = "zmk,animation-solid";
            pixels = <0 1 2 3>;
            colors = <HSL(0,100,25) HSL(0,0,0)>;
        };
    };
};
